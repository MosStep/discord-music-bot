# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# Token ของบอท จาก https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# prefix สำหรับคำสั่งแบบข้อความ (นอกเหนือจาก slash command)
COMMAND_PREFIX=!

# ใส่ id ของเซิร์ฟเวอร์เพื่อให้ slash command ขึ้นทันที (เว้นว่าง = sync แบบ global ใช้เวลาถึง 1 ชม.)
DEV_GUILD_ID=

# ออกจากห้องเสียงอัตโนมัติเมื่อไม่มีเพลงเล่นกี่วินาที
IDLE_TIMEOUT=300

# ระดับเสียงเริ่มต้น 0-200 (แนะนำ 100 = ไม่แตะสัญญาณเลย เสียงดีที่สุด)
DEFAULT_VOLUME=100

# bitrate ของ Opus encoder หน่วย kbps — เว้นว่าง = ใช้ตาม bitrate ของห้องเสียงอัตโนมัติ (แนะนำ)
OPUS_BITRATE=

# ปรับความดังให้เท่ากันทุกเพลง (EBU R128) 1 = เปิด, 0 = ปิด
# เปิดแล้วเสียงจะสม่ำเสมอขึ้นแต่ผ่านการบีบไดนามิก ถ้าเน้นคุณภาพดิบให้ปิดไว้
AUDIO_NORMALIZE=0

# path ของ ffmpeg ถ้าไม่ได้อยู่ใน PATH เช่น C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# ไฟล์ cookies ของ YouTube (Netscape format) ใช้เมื่อเจอ "Sign in to confirm you're not a bot"
YTDL_COOKIE_FILE=
